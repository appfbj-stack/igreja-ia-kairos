# =========================================================================
# Kairos Igreja — variáveis de ambiente (exemplo)
# Copie para .env e preencha os valores reais
# =========================================================================

# Provedor de LLM para o chat pastoral
# Opcoes: rules | MiniMax | deepseek | openrouter
#   - rules: motor de regras local (sem custo, sem internet)
#   - MiniMax: API MiniMax M3 (requer LLM_API_KEY)
#   - deepseek: API DeepSeek direta (requer LLM_API_KEY)
#   - openrouter: OpenRouter.ai — unifica varios modelos (requer LLM_API_KEY)
LLM_PROVIDER=rules

# Chave de API do provedor escolhido acima
LLM_API_KEY=

# Modelo (deixe vazio para usar o padrao do provedor)
# openrouter:  deepseek/deepseek-chat-v3.1:free  |  MiniMax/M3  |  anthropic/claude-3.5-sonnet
# deepseek:    deepseek-chat
# MiniMax:     MiniMax/M3
LLM_MODEL=

# URL custom da API (opcional, normalmente nao precisa)
LLM_BASE_URL=

# OpenRouter pede um referrer
OPENROUTER_REFERRER=https://igreja.fbautomacao.space

# Identidade da igreja (usada nos PDFs)
IGREJA_NOME=Igreja Kairos
IGREJA_ENDERECO=Endereço da Sede
IGREJA_CNPJ=00.000.000/0001-00
