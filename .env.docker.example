# =========================================================================
# Kairos Igreja — env vars para docker compose
# Copie para .env.docker e preencha antes do deploy
# =========================================================================

# Provedor LLM: rules | MiniMax | deepseek | openrouter
LLM_PROVIDER=rules
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Identidade da igreja
IGREJA_NOME=Igreja Kairos
IGREJA_ENDERECO=Endereço da Sede
IGREJA_CNPJ=00.000.000/0001-00

# URL publica do backend (usada pelo frontend no build)
NEXT_PUBLIC_API_URL=https://igreja.fbautomacao.space/api
